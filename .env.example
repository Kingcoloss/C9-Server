# Copy to .env next to compose.yaml to change defaults. Never put passwords here:
# secrets are generated by c9-init in artifacts/docker-state/secrets/.

# Packet trace payloads: redact-credentials (default) | headers | full (development only, records login data)
C9_TRACE_PAYLOADS=redact-credentials

# Host ports (always bound to 127.0.0.1)
C9_LOGIN_PORT=14000
C9_LOBBY_PORT=14001
C9_PORTAL_PORT=14880
C9_GRAFANA_PORT=3000
C9_PROMETHEUS_PORT=9090
C9_DB_PORT=5432

# Game database (Accounts/World modules). Enable together with: docker compose --profile gamedata up -d
# C9_DB_CONNECTION=Host=c9-db;Port=5432;Database=c9;Username=c9;Gss Encryption Mode=Disable

# Where the shared state lives (operator key, audit, traces, characters, secrets)
# C9_STATE_DIR=./artifacts/docker-state
