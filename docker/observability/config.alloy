// Ships the logs of every container in this compose project to Loki.
// Game services print one JSON event per line ({"event": "...", "session_key": ...}); the
// event name becomes the low-cardinality label "event", everything else stays in the line.
discovery.docker "c9" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "10s"
  filter {
    name   = "label"
    values = ["com.docker.compose.project=c9"]
  }
}

discovery.relabel "c9" {
  targets = []
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "c9" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.c9.targets
  relabel_rules = discovery.relabel.c9.rules
  labels        = { project = "c9" }
  forward_to    = [loki.process.c9.receiver]
}

loki.process "c9" {
  stage.match {
    selector = "{service=~\"c9-login|c9-lobby\"}"
    stage.json {
      expressions = { event = "event" }
    }
    stage.labels {
      values = { event = "" }
    }
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
