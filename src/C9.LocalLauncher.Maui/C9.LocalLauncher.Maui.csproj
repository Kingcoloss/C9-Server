<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <AssemblyName>L9</AssemblyName>
    <RootNamespace>C9.LocalLauncher.Maui</RootNamespace>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishSelfContained>true</PublishSelfContained>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifierOverride)' != ''">$(RuntimeIdentifierOverride)</RuntimeIdentifier>
    <ApplicationTitle>C9 Local Launcher</ApplicationTitle>
    <ApplicationId>com.c9local.launcher</ApplicationId>
    <ApplicationDisplayVersion>2.0</ApplicationDisplayVersion>
    <ApplicationVersion>2</ApplicationVersion>
    <!-- Ship only Thai, English and Chinese (Simplified) resources: .NET satellites and WinUI .mui folders. -->
    <SatelliteResourceLanguages>th;th-TH;en;en-US;en-GB;zh-Hans;zh-CN</SatelliteResourceLanguages>
    <!-- Trim unused code from framework/SDK assemblies only (partial); our own assemblies and their
         reflection-based System.Text.Json use stay intact. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../C9.ClientProfiles/C9.ClientProfiles.csproj"
                      GlobalPropertiesToRemove="RuntimeIdentifier;RuntimeIdentifierOverride;SelfContained" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <MauiIcon Include="Resources/AppIcon/appicon.svg" />
    <!-- Windows App SDK parts L9 never calls (Windows AI, ONNX/DirectML, Widgets): keep their files out of the app.
         Versions are the ones MAUI $(MauiVersion) brings in; update them together with MAUI. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="1.8.76" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" Version="1.8.2197" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" Version="1.8.251231004" ExcludeAssets="all" />
    <AssemblyMetadata Include="C9WorkspaceRoot" Value="$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../..'))" />
  </ItemGroup>
  <!-- Windows App SDK publishes WinUI .mui strings for ~86 languages; keep the same three as SatelliteResourceLanguages. -->
  <Target Name="C9KeepWinUILanguages" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="'%(Extension)' == '.mui' and !$([System.Text.RegularExpressions.Regex]::IsMatch('%(RelativePath)', '(?i)^(th-TH|en-US|en-GB|zh-CN)[\\/]'))" />
      <!-- The self-contained Windows App SDK runtime still carries the native AI/ML/Widgets files excluded above. -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(RelativePath)', '(?i)^(NpuDetect[\\/]|DirectML\.dll$|onnxruntime|Microsoft\.Windows\.(AI|Widgets|Workloads|Private\.Workloads|Vision|VisionInternal|Internal\.Vision|SemanticSearch)\.|workloads\.)'))" />
    </ItemGroup>
  </Target>
</Project>
