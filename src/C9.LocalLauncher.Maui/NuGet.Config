<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher-only restore settings: the MAUI/WinAppSDK packages come from nuget.org.
     Overrides the repo-root package source mapping for this project folder only. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
