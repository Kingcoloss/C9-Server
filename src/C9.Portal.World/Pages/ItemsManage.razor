@page "/items/manage"
@rendermode InteractiveServer
@attribute [Authorize(Policy = PortalPolicies.AccountsRead)]
@inject IServiceProvider Services
@inject PortalActions Actions

<PageTitle>Items management</PageTitle>

<GameDataGate Actions="Actions">
    <header class="page-head">
        <div>
            <p class="eyebrow">ITEMS</p>
            <h1>Items management</h1>
            <p class="muted">สร้าง item bundle และส่ง item ให้ตัวละครหรือบัญชี ทีละคนหรือหลายคน</p>
        </div>
    </header>
    <div class="alert warn small">
        ของที่ส่งจะเข้า Gift Box ในเกม (ไอคอนกระเป๋า → หน้าต่าง Mailbox แท็บ Gift Chest) ผู้เล่นเปิดแล้วกด Retrieve เพื่อรับเข้ากระเป๋า
        · รายการที่ยัง "อยู่ใน Gift Box" ยกเลิกได้ · ส่งให้บัญชี = ตัวละครใดของบัญชีนั้นรับก่อนก็ได้ (รับได้ครั้งเดียว)
        · Bundle ที่ตั้งเป็น "ชุดเริ่มเล่น" จะเข้า Gift Box ของทุกตัวละครที่สร้างใหม่ในเกม
    </div>

    <AuthorizeView Policy="@PortalPolicies.AccountsWrite">
        <section class="panel">
            <h2>ส่ง item</h2>
            <div class="filters">
                <label class="field">ส่งให้
                    <select @bind="target">
                        <option value="@DeliveryTarget.Character">ตัวละคร (ชื่อตัวละคร)</option>
                        <option value="@DeliveryTarget.Account">บัญชี (ชื่อ login)</option>
                    </select>
                </label>
                @if (target == DeliveryTarget.Account)
                {
                    <label class="check"><input type="checkbox" @bind="allAccounts" /> ทุกบัญชีที่ใช้งานอยู่</label>
                }
                <label class="field">Bundle
                    <select @bind="bundleId">
                        <option value="0">— ไม่ใช้ bundle —</option>
                        @foreach (ItemBundle b in bundles.Where(b => b.Enabled)) { <option value="@b.Id">@b.Name (@b.Entries.Count รายการ)</option> }
                    </select>
                </label>
            </div>
            <div class="filters">
                @if (!(target == DeliveryTarget.Account && allAccounts))
                {
                    <div class="field" style="flex:1">
                        <label class="field">ค้นหาตัวละครหรือบัญชี
                            <input @bind="recipientQuery" @bind:event="oninput" @bind:after="SearchRecipientsAsync" placeholder="พิมพ์ชื่ออย่างน้อย 2 ตัว" autocomplete="off" />
                        </label>
                        @if (hits.Count > 0)
                        {
                            <ul class="panel small" style="list-style:none;margin:.2rem 0;padding:.3rem;max-height:14rem;overflow:auto">
                                @foreach (RecipientView hit in hits)
                                {
                                    bool usable = hit.Kind == DeliveryTarget.Account ? target == DeliveryTarget.Account : true;
                                    <li>
                                        <button disabled="@(!usable)" style="width:100%;text-align:left" @onclick="() => AddRecipient(hit)">
                                            @if (hit.Kind == DeliveryTarget.Character)
                                            {
                                                <span>ตัวละคร <strong>@hit.Name</strong> (Lv @hit.Level) · บัญชี <strong>@hit.AccountLogin</strong></span>
                                            }
                                            else
                                            {
                                                <span>บัญชี <strong>@hit.AccountLogin</strong></span>
                                            }
                                        </button>
                                    </li>
                                }
                            </ul>
                        }
                        <label class="field">ผู้รับ (บรรทัดละคน หรือคั่นด้วย , )
                            <textarea rows="4" @bind="recipients" placeholder="Lab&#10;Lab2"></textarea>
                        </label>
                    </div>
                }
                <label class="field" style="flex:1">item เพิ่มเติม (บรรทัดละ "ID x จำนวน")
                    <textarea rows="4" @bind="sendLines" @bind:after="Preview" placeholder="20332 x 1&#10;9603 x 5"></textarea>
                </label>
            </div>
            @if (preview.Count > 0)
            {
                <div class="filters">
                    @foreach ((ItemLine line, CatalogItem? item) in preview)
                    {
                        <span class="badge idle" title="@line.ItemId">
                            @if (item?.Icon is { } icon) { <img src="@($"/api/v1/items/icons/{icon}.png")" alt="" width="20" height="20" /> }
                            @(item?.NameEn ?? item?.NameKo ?? $"ไม่พบ ID {line.ItemId}") × @line.Quantity
                        </span>
                    }
                </div>
            }
            <div class="filters">
                <label class="field" style="flex:1">ข้อความถึงผู้รับ <input @bind="message" maxlength="200" /></label>
                <label class="field">เหตุผล <input @bind="sendReason" placeholder="จำเป็น" /></label>
                <button class="primary" @onclick="SendAsync">ส่ง</button>
            </div>
        </section>
    </AuthorizeView>

    <section class="panel">
        <h2>Item bundles</h2>
        <div class="table-scroll">
            <table>
                <thead><tr><th>ชื่อ</th><th>item</th><th>สถานะ</th><th></th></tr></thead>
                <tbody>
                    @foreach (ItemBundle b in bundles)
                    {
                        <tr>
                            <td>@b.Name<div class="muted small">@b.Description</div></td>
                            <td class="small">@string.Join(", ", b.Entries.OrderBy(e => e.Line).Select(e => $"{Name(e.ItemId)} ×{e.Quantity}"))</td>
                            <td>
                                <span class="badge @(b.Enabled ? "ok" : "bad")">@(b.Enabled ? "ใช้งาน" : "ปิด")</span>
                                @if (b.Starter) { <span class="badge ok" title="ตัวละครที่สร้างใหม่ในเกมได้ของชุดนี้ใน Gift Box">ชุดเริ่มเล่น</span> }
                            </td>
                            <td>
                                <AuthorizeView Policy="@PortalPolicies.WorldWrite" Context="auth">
                                    <button @onclick="() => Edit(b)">แก้</button>
                                    @if (b.Starter) { <button title="ใช้เหตุผลในช่องด้านล่าง" @onclick="() => StarterAsync(null)">เลิกใช้เป็นชุดเริ่มเล่น</button> }
                                    else if (b.Enabled) { <button title="ใช้เหตุผลในช่องด้านล่าง" @onclick="() => StarterAsync(b.Id)">ตั้งเป็นชุดเริ่มเล่น</button> }
                                </AuthorizeView>
                            </td>
                        </tr>
                    }
                    @if (bundles.Count == 0) { <tr><td colspan="4" class="muted small">ยังไม่มี bundle</td></tr> }
                </tbody>
            </table>
        </div>
        <AuthorizeView Policy="@PortalPolicies.WorldWrite">
            <h3>@(editing is null ? "สร้าง bundle" : $"แก้ bundle: {editing.Name}")</h3>
            <div class="filters">
                <label class="field">ชื่อ <input @bind="bundleName" maxlength="100" /></label>
                <label class="field" style="flex:1">คำอธิบาย <input @bind="bundleDescription" maxlength="1000" /></label>
                @if (editing is not null) { <label class="check"><input type="checkbox" @bind="bundleEnabled" /> ใช้งาน</label> }
            </div>
            <div class="filters">
                <label class="field" style="flex:1">item (บรรทัดละ "ID x จำนวน")
                    <textarea rows="5" @bind="bundleLines" placeholder="20332 x 1&#10;9603 x 5"></textarea>
                </label>
            </div>
            <div class="filters">
                <label class="field">เหตุผล <input @bind="bundleReason" placeholder="จำเป็น" /></label>
                <button class="primary" @onclick="SaveBundleAsync">@(editing is null ? "สร้าง" : "บันทึก")</button>
                @if (editing is not null) { <button @onclick="ResetBundle">ยกเลิก</button> }
            </div>
        </AuthorizeView>
    </section>

    <section class="panel">
        <h2>ประวัติการส่ง</h2>
        <div class="filters">
            <label class="field">สถานะ
                <select @bind="statusFilter" @bind:after="LoadDeliveriesAsync">
                    <option value="">ทั้งหมด</option>
                    <option value="@DeliveryStatus.Pending">อยู่ใน Gift Box</option>
                    <option value="@DeliveryStatus.Delivered">รับเข้ากระเป๋าแล้ว</option>
                    <option value="@DeliveryStatus.Cancelled">ยกเลิก</option>
                </select>
            </label>
            <label class="field">ผู้รับ <input @bind="recipientFilter" @bind:after="LoadDeliveriesAsync" placeholder="ชื่อตัวละครหรือ login" /></label>
            <span class="muted small">@deliveries.Total.ToString("N0") รายการ (แสดงล่าสุด 100)</span>
        </div>
        <div class="table-scroll">
            <table>
                <thead><tr><th></th><th>item</th><th>จำนวน</th><th>ผู้รับ</th><th>สถานะ</th><th>โดย / เหตุผล</th><th>เวลา</th><th></th></tr></thead>
                <tbody>
                    @foreach (DeliveryView d in deliveries.Items)
                    {
                        <tr>
                            <td>@if (d.Icon is { } icon) { <img src="@($"/api/v1/items/icons/{icon}.png")" alt="" width="28" height="28" loading="lazy" /> }</td>
                            <td>@(d.ItemName ?? "—") <span class="muted small">#@d.ItemId</span></td>
                            <td>@d.Quantity</td>
                            <td>@(d.Target == DeliveryTarget.Character ? $"ตัวละคร {d.CharacterName}" : $"บัญชี {d.AccountLogin}")</td>
                            <td><span class="badge @(d.Status switch { DeliveryStatus.Delivered => "ok", DeliveryStatus.Cancelled => "bad", _ => "busy" })">@StatusText(d.Status)</span><div class="muted small">@StatusDetail(d)</div></td>
                            <td class="small">@d.CreatedBy<div class="muted">@d.Reason</div></td>
                            <td class="small">@d.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                @if (d.Status == DeliveryStatus.Pending)
                                {
                                    <AuthorizeView Policy="@PortalPolicies.AccountsWrite" Context="auth">
                                        <button class="danger" title="ยกเลิกทั้งชุดที่ส่งพร้อมกัน" @onclick="() => CancelAsync(d.BatchId)">ยกเลิกชุดนี้</button>
                                    </AuthorizeView>
                                }
                            </td>
                        </tr>
                    }
                    @if (deliveries.Items.Count == 0) { <tr><td colspan="8" class="muted small">ยังไม่มีรายการ</td></tr> }
                </tbody>
            </table>
        </div>
        <AuthorizeView Policy="@PortalPolicies.AccountsWrite">
            <div class="filters"><label class="field">เหตุผลการยกเลิก <input @bind="cancelReason" placeholder="จำเป็นเมื่อกดยกเลิก" /></label></div>
        </AuthorizeView>
    </section>
</GameDataGate>

@code {
    private IReadOnlyList<ItemBundle> bundles = [];
    private Page<DeliveryView> deliveries = new([], 0, 0, 100);
    private readonly Dictionary<int, CatalogItem?> names = new();
    private List<(ItemLine Line, CatalogItem? Item)> preview = [];
    private DeliveryTarget target = DeliveryTarget.Character;
    private bool allAccounts, bundleEnabled = true;
    private long bundleId;
    private string? recipients, sendLines, message, sendReason, bundleName, bundleDescription, bundleLines, bundleReason, cancelReason, recipientFilter;
    private string statusFilter = "";
    private ItemBundle? editing;

    private ItemService Items => (ItemService)Services.GetService(typeof(ItemService))!;
    private string? recipientQuery;
    private IReadOnlyList<RecipientView> hits = [];

    private async Task SearchRecipientsAsync()
    {
        hits = recipientQuery is { Length: >= 2 } q ? await Items.FindRecipientsAsync(q, 15) : [];
    }

    /// <summary>A character adds its name (character target) or its account login (account target); an account adds its login.</summary>
    private void AddRecipient(RecipientView hit)
    {
        string name = target == DeliveryTarget.Account ? hit.AccountLogin : hit.Name;
        List<string> current = ItemLines.Names(recipients).ToList();
        if (!current.Contains(name, StringComparer.OrdinalIgnoreCase)) current.Add(name);
        recipients = string.Join(Environment.NewLine, current);
    }

    protected override async Task OnInitializedAsync()
    {
        if (!GameDataApi.Configured(Services)) return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        bundles = await Items.BundlesAsync();
        await ResolveAsync(bundles.SelectMany(b => b.Entries.Select(e => e.ItemId)));
        await LoadDeliveriesAsync();
    }

    private async Task LoadDeliveriesAsync()
    {
        DeliveryStatus? status = Enum.TryParse(statusFilter, out DeliveryStatus parsed) ? parsed : null;
        deliveries = await Items.DeliveriesAsync(status, null, recipientFilter, 0, 100);
    }

    private async Task ResolveAsync(IEnumerable<int> ids)
    {
        foreach (int id in ids.Distinct().Where(i => !names.ContainsKey(i)).Take(200)) names[id] = await Items.GetCatalogAsync(id);
    }

    private string Name(int id) => names.GetValueOrDefault(id) is { } item ? item.NameEn ?? item.NameKo ?? $"#{id}" : $"#{id}";

    private async Task Preview()
    {
        IReadOnlyList<ItemLine> lines = ItemLines.Parse(sendLines).Lines;
        await ResolveAsync(lines.Select(l => l.ItemId));
        preview = lines.Select(l => (l, names.GetValueOrDefault(l.ItemId))).ToList();
    }

    private static string StatusText(DeliveryStatus status) => status switch
    {
        DeliveryStatus.Pending => "อยู่ใน Gift Box",
        DeliveryStatus.Delivered => "รับเข้ากระเป๋าแล้ว",
        _ => "ยกเลิก",
    };

    // Who/when for the status column: the character that took it, or that the player deleted it in game.
    private static string StatusDetail(DeliveryView d) => d.Status switch
    {
        DeliveryStatus.Delivered => $"{d.ClaimedBy} · {d.DeliveredAt?.ToLocalTime():yyyy-MM-dd HH:mm}",
        DeliveryStatus.Cancelled when d.CancelledBy?.StartsWith("game:") == true => "ผู้เล่นลบในเกม",
        DeliveryStatus.Cancelled => d.CancelledBy ?? "",
        _ => d.OpenedAt is null ? "ยังไม่เปิดอ่าน" : "เปิดอ่านแล้ว",
    };

    private async Task SendAsync()
    {
        (IReadOnlyList<ItemLine> lines, IReadOnlyList<string> errors) = ItemLines.Parse(sendLines);
        if (errors.Count > 0) { await Actions.RunAsync<bool>("items.send", "item_delivery:new", sendReason, _ => throw new GameDataException(GameDataError.Invalid, "อ่านบรรทัด item ไม่ได้: " + string.Join(" | ", errors))); return; }
        bool owner = (await Actions.UserAsync()).IsInRole(PortalRoles.Owner);
        DeliveryRequest request = new(target, ItemLines.Names(recipients), target == DeliveryTarget.Account && allAccounts,
            bundleId == 0 ? null : bundleId, lines, message, AllowAdminItems: owner);
        DeliveryResult? result = await Actions.RunAsync("items.send", "item_delivery:new", sendReason, op => Items.SendAsync(request, op), "ส่งแล้ว");
        if (result is not null)
        {
            (recipients, sendLines, message, sendReason, preview) = (null, null, null, null, []);
            await LoadDeliveriesAsync();
        }
    }

    private async Task CancelAsync(Guid batch)
    {
        if (await Actions.RunAsync("items.cancel", $"item_delivery_batch:{batch}", cancelReason, op => Items.CancelBatchAsync(batch, op), "ยกเลิกแล้ว") > 0)
            cancelReason = null;
        await LoadDeliveriesAsync();
    }

    private void Edit(ItemBundle bundle)
    {
        editing = bundle;
        (bundleName, bundleDescription, bundleEnabled) = (bundle.Name, bundle.Description, bundle.Enabled);
        bundleLines = ItemLines.Format(bundle.Entries.OrderBy(e => e.Line).Select(e => new ItemLine(e.ItemId, e.Quantity)));
    }

    private void ResetBundle()
    {
        editing = null;
        (bundleName, bundleDescription, bundleLines, bundleEnabled) = (null, null, null, true);
    }

    // Item สนับสนุนตอนเริ่มเล่น: one bundle goes to the Gift Box of every character created in game.
    private async Task StarterAsync(long? id)
    {
        bool owner = (await Actions.UserAsync()).IsInRole(PortalRoles.Owner);
        bool? done = await Actions.RunAsync("items.starter", $"item_bundle:{id?.ToString() ?? "none"}", bundleReason,
            async op => { await Items.SetStarterBundleAsync(id, owner, op); return true; }, id is null ? "เลิกใช้ชุดเริ่มเล่นแล้ว" : "ตั้งชุดเริ่มเล่นแล้ว");
        if (done == true) { bundleReason = null; await LoadAsync(); }
    }

    private async Task SaveBundleAsync()
    {
        (IReadOnlyList<ItemLine> lines, IReadOnlyList<string> errors) = ItemLines.Parse(bundleLines);
        if (errors.Count > 0) { await Actions.RunAsync<bool>("items.bundle", "item_bundle", bundleReason, _ => throw new GameDataException(GameDataError.Invalid, "อ่านบรรทัด item ไม่ได้: " + string.Join(" | ", errors))); return; }
        ItemBundle? saved = editing is null
            ? await Actions.RunAsync("items.bundle_create", "item_bundle:new", bundleReason, op => Items.CreateBundleAsync(bundleName ?? "", bundleDescription, lines, op), "สร้าง bundle แล้ว")
            : await Actions.RunAsync("items.bundle_update", $"item_bundle:{editing.Id}", bundleReason,
                op => Items.UpdateBundleAsync(editing.Id, editing.Version, bundleName ?? "", bundleDescription, bundleEnabled, lines, op), "บันทึก bundle แล้ว");
        if (saved is not null)
        {
            bundleReason = null;
            ResetBundle();
            await LoadAsync();
        }
    }
}
