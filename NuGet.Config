<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The protocol/server port uses installed .NET shared frameworks only.
       ADR 0002 allows the EF Core + Npgsql data-access packages for src/C9.GameData
       (and its design-time tool). Source mapping restricts nuget.org to those names. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <!-- Runtime: src/C9.GameData -->
      <package pattern="Npgsql" />
      <package pattern="Npgsql.EntityFrameworkCore.PostgreSQL" />
      <package pattern="Microsoft.EntityFrameworkCore" />
      <package pattern="Microsoft.EntityFrameworkCore.Abstractions" />
      <package pattern="Microsoft.EntityFrameworkCore.Analyzers" />
      <package pattern="Microsoft.EntityFrameworkCore.Relational" />
      <!-- ADR 0003: src/C9.Portal (Blazor Web App). The .NET 10 SDK references this first-party
           package implicitly; it only carries the framework's blazor.web.js static assets. -->
      <package pattern="Microsoft.AspNetCore.App.Internal.Assets" />
      <!-- Design-time only: tools/C9.GameData.Design (migration generation, never shipped) -->
      <package pattern="Microsoft.EntityFrameworkCore.Design" />
      <package pattern="Microsoft.Extensions.DependencyModel" />
      <package pattern="Microsoft.CodeAnalysis.*" />
      <package pattern="Microsoft.Build.Framework" />
      <package pattern="Microsoft.VisualStudio.SolutionPersistence" />
      <package pattern="Humanizer.Core" />
      <package pattern="Mono.TextTemplating" />
      <package pattern="Newtonsoft.Json" />
      <package pattern="System.CodeDom" />
      <package pattern="System.Composition*" />
      <package pattern="dotnet-ef" />
    </packageSource>
  </packageSourceMapping>
</configuration>
